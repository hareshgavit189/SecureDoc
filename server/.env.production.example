# ==============================================================================
# SecureDoc DMS - Production Environment Configuration
# Generate secure keys before deploying:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production

# Database Connection (MongoDB Atlas or self-hosted replica set)
MONGO_URI=mongodb+srv://securedoc_admin:<SECURE_PASSWORD>@cluster0.mongodb.net/legal_dms?retryWrites=true&w=majority

# Cryptographic Authentication Secrets (Min 32 characters, base64 or hex)
JWT_ACCESS_SECRET=REPLACE_WITH_GENERATED_64_CHAR_RANDOM_SECRET_KEY_FOR_ACCESS_JWT
JWT_REFRESH_SECRET=REPLACE_WITH_GENERATED_64_CHAR_RANDOM_SECRET_KEY_FOR_REFRESH_JWT

# KMS / Master Symmetric Key for AES-256-GCM Envelope Encryption (Exactly 64 hex characters = 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY_HEX=REPLACE_WITH_EXACT_64_HEX_CHARACTERS_MASTER_KEY_FOR_ENVELOPE_ENCRYPTION

# Allowed CORS Origin (Public URL of Frontend Web Portal)
CLIENT_ORIGIN=https://securedoc.yourdomain.gov.in
