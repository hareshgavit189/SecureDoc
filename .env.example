# Copy this file to .env for local Docker Compose or root-level deployment.
# Generate secrets with:
# node -e "const c=require('crypto'); console.log(c.randomBytes(32).toString('hex'))"

NODE_ENV=production
PORT=5000
MONGO_URI=mongodb://securedoc_admin:REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD@mongo:27017/legal_dms?authSource=admin
MONGO_ROOT_USERNAME=securedoc_admin
MONGO_ROOT_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
JWT_ACCESS_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
MASTER_KEY_HEX=REPLACE_WITH_64_HEX_CHARACTERS
CLIENT_ORIGIN=https://your-frontend.example.com
COOKIE_SAME_SITE=lax
