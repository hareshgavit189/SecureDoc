# ==============================================================================
# SecureDoc DMS Client - Production Environment Configuration
# ==============================================================================

# Option 1: Unified Deployment (Express serves client/dist on same port)
# Leave empty or set to empty string:
# VITE_API_URL=

# Option 2: Split Deployment (e.g. Vercel/Netlify frontend + Render/AWS backend)
# Set to the backend public URL:
# VITE_API_URL=https://api.securedoc.yourdomain.gov.in
